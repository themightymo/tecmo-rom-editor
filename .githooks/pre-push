#!/bin/sh
# Rebuild dist/index.html before every push, and cancel the push if the build fails.
# Enable once per clone with: git config core.hooksPath .githooks
# Skip once with: git push --no-verify

echo "pre-push: running npm run build..."
if ! npm run build --silent; then
  echo "pre-push: build failed, push cancelled." >&2
  exit 1
fi
